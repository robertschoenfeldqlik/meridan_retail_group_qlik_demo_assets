# Dependencies
node_modules/

# Qlik deployment config (contains secrets)
deploy/config.json

# Temporary Office lock files
~$*

# OS files
.DS_Store
Thumbs.db

# Claude project files — local settings stay private, agent definitions are shared
.claude/*
!.claude/agents/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.vscode/
.idea/

# Deploy UI temp configs — these are written with UNMASKED secrets (API key,
# OAuth secret, DB passwords) while a child deploy/build process runs.
deploy/.config-*.json

# Environment
.env
.env.local

# Backup files
*.bak
*.bak2
*.bak-*

# QTCP declarative pipeline schema kit (Qlik internal preview — never commit).
# The ** form covers the per-project install location that setup-vscode-template.js
# uses (deploy/pipelines/<project>/schema/) as well as the legacy shared location.
deploy/pipelines/**/schema/
deploy/pipelines/schema/

# VS Code template tooling for the pipeline projects IS committed as a demo asset.
# Re-include it despite the global .vscode/ ignore above (the schema kit stays ignored).
!deploy/pipelines/**/.vscode/
!deploy/pipelines/**/.vscode/settings.json
!deploy/pipelines/**/.vscode/extensions.json

# Generated pipeline import package
deploy/pipelines/*.zip

# Generated Talend job import package (npm run talend:zip)
deploy/talend/*.zip

# Puppeteer profile used by capture-tenant-screenshots.js (holds a Qlik session)
generators/.chrome-profile/

# Built demo assets live outside the repo in the assets root
# (C:\Claude\MCG Demo by default — see generators/lib/asset-paths.js).
# These patterns stop a stray regenerate from re-adding them here.
#
# The hand-written .md under documents/ STAYS in the repo: it is authoring
# source, not output, and deleting the assets root must never destroy it.
# Only the generated binaries are ignored.
/MCG_*.pptx
/documents/**/*.docx
/documents/**/*.xlsx
