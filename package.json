{
  "name": "mcg-qlik-demo",
  "version": "1.0.0",
  "description": "Meridian Commerce Group — Qlik Cloud end-to-end demo environment",
  "main": "index.js",
  "scripts": {
    "ui": "node deploy/deploy-ui.js",
    "deploy": "node deploy/deploy-to-qlik.js",
    "deploy:dry-run": "node deploy/deploy-to-qlik.js --dry-run",
    "deploy:verbose": "node deploy/deploy-to-qlik.js --verbose",
    "deploy:export-pipeline": "node deploy/deploy-to-qlik.js --export-pipeline",
    "deploy:qvd": "node deploy/deploy-to-qlik.js --mode qvd",
    "deploy:gateway": "node deploy/deploy-to-qlik.js --mode gateway",
    "deploy:integration": "node deploy/deploy-to-qlik.js --module integration",
    "deploy:governance": "node deploy/deploy-to-qlik.js --module governance",
    "deploy:analytics": "node deploy/build-apps.js && node deploy/deploy-to-qlik.js --module analytics",
    "deploy:ai": "node deploy/apps/gen-mcp-prompts-md.js && node deploy/deploy-to-qlik.js --module ai",
    "module:integration:build": "node deploy/build-talend-job.js && node deploy/build-talend-zip.js && node deploy/build-pipeline-zip.js",
    "window:status": "node deploy/test-window.js status",
    "window:open": "node deploy/test-window.js open",
    "window:stop-tasks": "node deploy/test-window.js stop-tasks",
    "window:close": "node deploy/test-window.js close",
    "window:report": "node deploy/test-window.js report",
    "data:qvd": "node deploy/mockdata/gen-lakehouse-csv.js && node deploy/mockdata/upload-lakehouse-csv.js && node deploy/mockdata/repoint-load-scripts.js qvd",
    "pipeline:zip": "node deploy/build-pipeline-zip.js",
    "pipeline:template": "node deploy/pipelines/setup-vscode-template.js",
    "talend:zip": "node deploy/build-talend-zip.js",
    "talend:zip:dry-run": "node deploy/build-talend-zip.js --dry-run",
    "stewardship:sprint": "node deploy/stewardship.js",
    "stewardship:sprint:dry-run": "node deploy/stewardship.js --dry-run",
    "stewardship:sprint:list": "node deploy/stewardship.js --list",
    "automations:workspaces": "node deploy/automation-workspaces.js",
    "automations:workspaces:dry-run": "node deploy/automation-workspaces.js --dry-run",
    "build-apps": "node deploy/build-apps.js",
    "build-apps:dry-run": "node deploy/build-apps.js --dry-run",
    "build-automations": "node deploy/build-automations.js",
    "build-automations:dry-run": "node deploy/build-automations.js --dry-run",
    "generate": "node generators/generate-all.js",
    "generate:list": "node generators/generate-all.js --list",
    "generate:docs": "node generators/generate-all.js --only documents",
    "generate:presentations": "node generators/generate-all.js --only presentations",
    "generate:demos": "node generators/generate-all.js --only demos",
    "generate:modules": "node generators/generate-all.js --only modules",
    "screenshots": "node generators/capture-tenant-screenshots.js",
    "screenshots:login": "node generators/capture-tenant-screenshots.js --login",
    "screenshots:report": "node generators/capture-tenant-screenshots.js --report",
    "engine": "node -e \"const{resolveEngine}=require('./deploy/container-engine');const e=resolveEngine();console.log('engine:    '+e.name+(e.available?' ('+e.version+')':' — NOT AVAILABLE'));console.log('binary:    '+e.bin);console.log('compose:   '+(e.compose.available?e.compose.kind:'none'));if(Object.keys(e.env||{}).length)console.log('env:       '+JSON.stringify(e.env));if(e.error)console.log('problem:   '+e.error);process.exit(e.available&&e.compose.available?0:1)\"",
    "stack:up": "npm run docker:up",
    "stack:up:dmg": "npm run docker:up:dmg",
    "stack:down": "npm run docker:down",
    "stack:status": "npm run docker:status",
    "stack:logs": "npm run docker:logs",
    "docker:up": "node deploy/compose.js -f docker-compose.full-stack.yml up -d",
    "docker:up:dmg": "node deploy/compose.js -f docker-compose.full-stack-dmg.yml up -d --build",
    "docker:up:kafka": "node deploy/compose.js -f kafka/docker-compose.yml up -d",
    "docker:up:simulators": "node deploy/compose.js -f docker-compose.simulators.yml up -d",
    "docker:up:simulators-dmg": "node deploy/compose.js -f docker-compose.simulators-dmg.yml up -d",
    "docker:up:dmg-only": "node deploy/compose.js -f docker-compose.dmg.yml up -d --build",
    "docker:down": "node deploy/compose.js -f docker-compose.full-stack.yml down",
    "docker:down:dmg": "node deploy/compose.js -f docker-compose.full-stack-dmg.yml down",
    "docker:status": "node deploy/compose.js -f docker-compose.full-stack.yml ps",
    "docker:logs": "node deploy/compose.js -f docker-compose.full-stack.yml logs --tail=50",
    "db:schema": "node deploy/compose.js exec -i mcg-postgres psql -U mcg_admin -d mcg_wms -f /dev/stdin < simulators/schema.sql",
    "db:seed": "node deploy/compose.js exec mcg-seed-data python seed_data.py --postgres --pg-host postgres --pg-db mcg_wms --pg-user mcg_admin --pg-pass mcg_demo_2025 --mysql --my-host mysql --my-port 3306 --my-db mcg_crm --my-user root --my-pass mcg_root_2025",
    "lint": "npm run lint:syntax && npm run lint:requires && npm run lint:app-fields",
    "lint:syntax": "node -e \"const{execFileSync}=require('child_process'),fs=require('fs'),p=require('path');const skip=new Set(['node_modules','.git','.chrome-profile','gateway']);let n=0;const bad=[];(function w(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){if(skip.has(e.name))continue;const f=p.join(d,e.name);if(e.isDirectory())w(f);else if(e.name.endsWith('.js')){n++;try{execFileSync(process.execPath,['-c',f],{stdio:'pipe'})}catch(err){bad.push(f)}}}})('.');if(bad.length){console.error('Syntax errors:');bad.forEach(f=>console.error('  '+f));process.exit(1)}console.log('Syntax OK: '+n+' JS file(s)')\"",
    "lint:requires": "node deploy/validate-requires.js",
    "lint:app-fields": "node deploy/validate-app-fields.js",
    "db:crm": "node deploy/compose.js exec -it mcg-mysql mysql -uqlik_cdc -pmcg_crm_2025 mcg_crm",
    "review:video": "node generators/gen-ceo-video-review.js",
    "review:video:dry": "node generators/gen-ceo-video-review.js --dry-run",
    "review:video:replay": "node generators/gen-ceo-video-review.js --verdicts generators/rubrics/reviews/2026-09-24-agentic.verdicts.json --memo generators/rubrics/reviews/2026-09-24-agentic.memo.md",
    "review:pillars": "node generators/review-pillars.js --status",
    "review:pillars:run": "node generators/review-pillars.js --run",
    "review:pillar": "node generators/gen-ceo-video-review.js --pillar",
    "review:pillars:dry": "node generators/gen-ceo-video-review.js --pillar all --dry-run",
    "review:pillars:replay": "node generators/review-pillars.js --replay",
    "review:selftest": "node --test generators/test/review-gate.test.js",
    "review:deck": "node generators/review-deck.js --rubric integration --verdicts generators/rubrics/reviews/2026-10-26-integration-deck.verdicts.json",
    "review:ui": "node generators/review-ui.js"
  },
  "keywords": [
    "qlik",
    "demo",
    "supply-chain",
    "data-quality",
    "analytics"
  ],
  "author": "Robert Schoenfeld",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "docx": "^9.6.0",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "puppeteer": "^24.37.5"
  }
}
