    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_1"/>
    <elementParameter field="MEMO_JAVA" name="START_CODE" value=""/>
    <elementParameter field="MEMO_JAVA" name="MAIN_CODE" value="AddressStandardizer.Result r = AddressStandardizer.standardize(
    input_row.contact_id, input_row.first_name, input_row.last_name, input_row.email,
    null, input_row.city, input_row.state_region,
    input_row.postal_code, input_row.country_iso);

r.qualityScore = AddressFormatValidator.formatScore(
    input_row.city, input_row.state_region, input_row.postal_code, input_row.country_iso);

AddressBatch.add(r);"/>
    <elementParameter field="MEMO_JAVA" name="END_CODE" value=""/>
    <elementParameter field="CHECK" name="IS_AUTO_PROPAGATE" value="false"/>
  </node>
  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="96" posY="256" xmi:id="_c304db71-480c-1c69-8b08-c7180b10f7da">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="BulkGeocoder.Summary s = BulkGeocoder.geocodeAll(
    AddressBatch.all(),
    context.nominatim_base_url,
    context.nominatim_user_agent,
    Long.parseLong(context.nominatim_throttle_ms),
    1,
    Long.parseLong(context.geocode_budget_ms));
System.out.println(&quot;geocoded &quot; + s.resolved + &quot;/&quot; + s.total);"/>
  </node>
