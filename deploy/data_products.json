      "ownerTitle": "EU Logistics Manager",
      "tags": ["carrier", "sla", "delivery", "wismo", "address-quality"],
      "sla": {
        "refreshFrequency": "30 minutes",
        "availability": "99.5%",
        "trustScoreTarget": 0.80
      },
      "schema": [
        {"name": "carrier", "type": "VARCHAR(20)", "description": "Canonical carrier code (FEDEX, DPD, NINJAVAN, etc.)"},
        {"name": "destination_country", "type": "VARCHAR(2)", "description": "ISO 3166-1 alpha-2 country code"},
        {"name": "destination_region", "type": "VARCHAR(20)", "description": "MCG region: EU, AMERICAS, APAC, LATAM, AFRICA"},
        {"name": "sla_target_hours", "type": "INTEGER", "description": "Contracted delivery SLA in hours"},
        {"name": "sla_actual_hours", "type": "DECIMAL(6,1)", "description": "Actual order-to-delivery hours"},
        {"name": "sla_met", "type": "BOOLEAN", "description": "TRUE if actual <= target"},
        {"name": "on_time_pct", "type": "DECIMAL(5,2)", "description": "On-time delivery percentage for this carrier/region"},
        {"name": "address_quality_score", "type": "DECIMAL(3,2)", "description": "Destination address quality (0.0-1.0)"},
        {"name": "wismo_flag", "type": "BOOLEAN", "description": "Customer contacted about this delivery"},
        {"name": "delivery_attempts", "type": "INTEGER", "description": "Number of delivery attempts"},
        {"name": "exception_code_canonical", "type": "VARCHAR(30)", "description": "Standardized exception code"},
        {"name": "weight_kg", "type": "DECIMAL(8,2)", "description": "Shipment weight in kg"},
        {"name": "trust_score", "type": "DECIMAL(3,2)", "description": "Qlik Trust Score (0.0-1.0)"}
      ],
      "nightmares": ["#2 Address Catastrophe", "#6 Carrier Data Black Hole"],
      "apiSharing": true,
      "consumers": ["Qlik Sense (Last Mile Dashboard)", "Predict (SLA Model)", "Discovery Agent"]
    },
    {
      "name": "Spoilage Risk",
      "description": "Cold chain shipment risk assessment combining IoT telemetry with carrier and route context. Real-time updates from Kafka streaming pipeline. Feeds the Spoilage Risk Predictor model.",
      "sourceTable": "gold.spoilage_risk",
      "owner": "Thomas Brennan",
      "ownerTitle": "VP Supply Chain",
      "tags": ["cold-chain", "iot", "risk", "spoilage", "predict"],
      "sla": {
        "refreshFrequency": "Real-time (streaming)",
        "availability": "99.0%",
        "trustScoreTarget": 0.75
      },
      "schema": [
        {"name": "shipment_id", "type": "VARCHAR(40)", "description": "Shipment identifier"},
        {"name": "route", "type": "VARCHAR(20)", "description": "Route code (e.g., GRU-BA-001)"},
        {"name": "carrier", "type": "VARCHAR(20)", "description": "Carrier code"},
        {"name": "product_type", "type": "VARCHAR(20)", "description": "FRESH / DAIRY / FROZEN"},
        {"name": "avg_temp_celsius", "type": "DECIMAL(4,1)", "description": "Average temperature across all readings"},
        {"name": "max_temp_celsius", "type": "DECIMAL(4,1)", "description": "Maximum temperature recorded"},
        {"name": "min_temp_celsius", "type": "DECIMAL(4,1)", "description": "Minimum temperature recorded"},
        {"name": "exceedance_minutes", "type": "INTEGER", "description": "Total minutes above threshold"},
        {"name": "pre_cool_compliant", "type": "BOOLEAN", "description": "Reefer reached 0°C before loading"},
        {"name": "spoilage_flag", "type": "BOOLEAN", "description": "TRUE if product spoiled (historical) or predicted to spoil"},
        {"name": "spoilage_probability", "type": "DECIMAL(3,2)", "description": "AutoML prediction (0.0-1.0)"},
        {"name": "estimated_loss_usd", "type": "DECIMAL(10,2)", "description": "Estimated financial exposure"},
        {"name": "sensor_count", "type": "INTEGER", "description": "Number of active sensors on this shipment"},
        {"name": "data_gap_flag", "type": "BOOLEAN", "description": "TRUE if >30 min gap in sensor readings"},
        {"name": "trust_score", "type": "DECIMAL(3,2)", "description": "Qlik Trust Score"}
      ],
      "nightmares": ["#4 Silent Pipelines", "#5 Timestamps", "#6 Carrier Data Black Hole"],
      "apiSharing": true,
      "consumers": ["Predict (Spoilage Model)", "Discovery Agent", "Teams Automation"]
    },
