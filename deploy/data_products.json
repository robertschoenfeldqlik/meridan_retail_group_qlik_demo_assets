{
  "dataProducts": [
    {
      "name": "Supply Chain Health",
      "description": "Real-time inventory accuracy, phantom inventory detection, and pipeline health status across all 28 distribution centers. Updated every 15 minutes from PostgreSQL CDC.",
      "sourceTable": "gold.supply_chain_health",
      "owner": "Henrik Jansen",
      "ownerTitle": "VP Warehouse Operations",
      "tags": ["inventory", "phantom-inventory", "pipeline-health", "kpi"],
      "sla": {
        "refreshFrequency": "15 minutes",
        "availability": "99.5%",
        "trustScoreTarget": 0.85
      },
      "schema": [
        {"name": "dc_id", "type": "VARCHAR(20)", "description": "Distribution center identifier (e.g., DC-RTD-01)"},
        {"name": "sku", "type": "VARCHAR(30)", "description": "Canonical MCG product SKU"},
        {"name": "qty_wms", "type": "INTEGER", "description": "Quantity per WMS (physical system of record)"},
        {"name": "qty_erp", "type": "INTEGER", "description": "Quantity per ERP (SAP S/4HANA)"},
        {"name": "variance", "type": "INTEGER", "description": "WMS - ERP quantity difference"},
        {"name": "variance_pct", "type": "DECIMAL(5,2)", "description": "Variance as percentage of ERP qty"},
        {"name": "phantom_flag", "type": "BOOLEAN", "description": "TRUE if ERP > WMS by >10%"},
        {"name": "pipeline_status", "type": "VARCHAR(20)", "description": "CDC pipeline: HEALTHY / DEGRADED / FAILED"},
        {"name": "last_sync_utc", "type": "TIMESTAMPTZ", "description": "Last successful CDC sync timestamp"},
        {"name": "sync_lag_minutes", "type": "INTEGER", "description": "Minutes since last sync"},
        {"name": "trust_score", "type": "DECIMAL(3,2)", "description": "Qlik Trust Score (0.0-1.0)"},
        {"name": "snapshot_utc", "type": "TIMESTAMPTZ", "description": "When this record was calculated"}
      ],
      "nightmares": ["#1 Phantom Inventory", "#4 Silent Pipeline Failures"],
      "apiSharing": true,
      "consumers": ["Qlik Sense (Supply Chain Dashboard)", "Discovery Agent", "MCP Server"]
    },
    {
      "name": "Last Mile Performance",
      "description": "Carrier delivery SLA performance by region, with address quality scoring and WISMO correlation. Combines shipment tracking from 6 carriers with customer order data.",
      "sourceTable": "gold.last_mile_performance",
