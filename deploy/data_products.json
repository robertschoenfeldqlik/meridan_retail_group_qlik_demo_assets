{
  "dataProducts": [
    {
      "name": "Supply Chain Health",
      "description": "Inventory record accuracy, phantom inventory detection and position trust scores across all 12 distribution centers in the governed estate. Updated every 15 minutes from PostgreSQL CDC.",
      "sourceTable": "gold.supply_chain_health",
      "owner": "Henrik Jansen",
      "ownerTitle": "VP Warehouse Operations",
      "tags": [
        "inventory",
        "phantom-inventory",
        "pipeline-health",
        "kpi"
      ],
      "sla": {
        "refreshFrequency": "15 minutes",
        "availability": "99.5%",
        "trustScoreTarget": 0.85
      },
      "schema": [
        {
          "name": "dc_id",
          "type": "VARCHAR(20)",
          "description": "Distribution center identifier (e.g., DC-RTD-01)"
        },
        {
          "name": "sku",
          "type": "VARCHAR(30)",
          "description": "Canonical MCG product SKU"
        },
        {
          "name": "qty_wms",
          "type": "INTEGER",
          "description": "Quantity per WMS (physical system of record)"
        },
        {
          "name": "qty_erp",
          "type": "INTEGER",
          "description": "Quantity per ERP (SAP S/4HANA)"
        },
        {
          "name": "variance",
          "type": "INTEGER",
          "description": "WMS - ERP quantity difference"
        },
        {
          "name": "variance_pct",
          "type": "DECIMAL(5,2)",
          "description": "Variance as percentage of ERP qty"
        },
        {
          "name": "phantom_flag",
          "type": "BOOLEAN",
          "description": "TRUE if ERP > WMS by >10%"
        },
        {
          "name": "pipeline_status",
          "type": "VARCHAR(20)",
          "description": "CDC pipeline: HEALTHY / DEGRADED / FAILED"
        },
        {
          "name": "last_sync_utc",
          "type": "TIMESTAMPTZ",
          "description": "Last successful CDC sync timestamp"
        },
        {
          "name": "sync_lag_minutes",
          "type": "INTEGER",
          "description": "Minutes since last sync"
        },
        {
          "name": "trust_score",
          "type": "DECIMAL(3,2)",
          "description": "Qlik Trust Score (0.0-1.0)"
        },
        {
          "name": "snapshot_utc",
          "type": "TIMESTAMPTZ",
          "description": "When this record was calculated"
        }
      ],
      "nightmares": [
        "#1 Phantom Inventory",
        "#4 Silent Pipeline Failures"
      ],
      "apiSharing": true,
      "consumers": [
        "Qlik Analytics (Supply Chain Dashboard)",
        "Discovery Agent",
        "MCP Server"
      ],
      "app": "MCG Supply Chain Operations"
    },
    {
      "name": "Last Mile Performance",
      "description": "Carrier delivery SLA performance by region, with address quality scoring and WISMO correlation. Combines shipment tracking from 6 carriers with customer order data.",
      "sourceTable": "gold.last_mile_performance",
      "owner": "Sophie Müller",
      "ownerTitle": "EU Logistics Manager",
      "tags": [
        "carrier",
        "sla",
        "delivery",
        "wismo",
        "address-quality"
      ],
      "sla": {
        "refreshFrequency": "30 minutes",
        "availability": "99.5%",
        "trustScoreTarget": 0.8
      },
      "schema": [
        {
          "name": "carrier",
          "type": "VARCHAR(20)",
          "description": "Canonical carrier code (FEDEX, DPD, NINJAVAN, etc.)"
        },
        {
          "name": "destination_country",
          "type": "VARCHAR(2)",
          "description": "ISO 3166-1 alpha-2 country code"
        },
        {
          "name": "destination_region",
          "type": "VARCHAR(20)",
          "description": "MCG region: EU, AMERICAS, APAC, LATAM, AFRICA"
        },
        {
          "name": "sla_target_hours",
          "type": "INTEGER",
          "description": "Contracted delivery SLA in hours"
        },
        {
          "name": "sla_actual_hours",
          "type": "DECIMAL(6,1)",
          "description": "Actual order-to-delivery hours"
        },
        {
          "name": "sla_met",
          "type": "BOOLEAN",
          "description": "TRUE if actual <= target"
        },
        {
          "name": "on_time_pct",
          "type": "DECIMAL(5,2)",
          "description": "On-time delivery percentage for this carrier/region"
        },
        {
          "name": "address_quality_score",
          "type": "DECIMAL(3,2)",
          "description": "Destination address quality (0.0-1.0)"
        },
        {
          "name": "wismo_flag",
          "type": "BOOLEAN",
          "description": "Customer contacted about this delivery"
        },
        {
          "name": "delivery_attempts",
          "type": "INTEGER",
          "description": "Number of delivery attempts"
        },
        {
          "name": "exception_code_canonical",
          "type": "VARCHAR(30)",
          "description": "Standardized exception code"
        },
        {
          "name": "weight_kg",
          "type": "DECIMAL(8,2)",
          "description": "Shipment weight in kg"
        },
        {
          "name": "trust_score",
          "type": "DECIMAL(3,2)",
          "description": "Qlik Trust Score (0.0-1.0)"
        }
      ],
      "nightmares": [
        "#2 Address Catastrophe",
        "#6 Carrier Data Black Hole"
      ],
      "apiSharing": true,
      "consumers": [
        "Qlik Analytics (Last Mile Dashboard)",
        "Predict (SLA Model)",
        "Discovery Agent"
      ],
      "app": "MCG Delivery Experience"
    }
  ]
}
