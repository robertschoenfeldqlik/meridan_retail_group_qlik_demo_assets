// =============================================================================
// MCG Supply Chain Operations — Qlik Analytics Load Script
// =============================================================================
// Loads directly from the data products and silver datasets created by the
// MCG Batch + Streaming Pipelines (declarative QTCP projects).
//
// Data Product (Gold):
//   - gold.supply_chain_health        (per-DC KPIs — Data Product "Supply Chain Health")
//
// Silver datasets (detail / live):
//   - silver.inventory_reconciled     (position-grain detail behind the gold KPIs)
//   - silver.products_harmonized      (product master)
//   - silver.iot_normalized           (cold-chain telemetry, streaming pipeline)
//
// Bronze (live feed):
//   - bronze.iot_carrier_events
//
// The connection name matches the deploy config (dataConnections.athena) —
// an Amazon Athena connection reading the Open Lakehouse on AWS.
// =============================================================================

SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='YYYY-MM-DD';
SET TimestampFormat='YYYY-MM-DD hh:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;

// >>> MCG lakehouse source switch — generated, do not hand-edit <<<
// Analytics reads come from the Qlik Open Lakehouse connection: bronze, silver and
// gold, one table per LOAD. Table names, column names and grain match the catalog.
// <<< end lakehouse source switch >>>

// =============================================================================
// 1. SUPPLY CHAIN HEALTH — Data Product (gold, per-DC grain)
// =============================================================================

SupplyChainHealth:
LOAD
    location_id                                          AS [Distribution Center],
    sku_positions                                        AS [SKU Positions],
    total_on_hand                                        AS [Total On Hand],
    phantom_suspect_count                                AS [Phantom Suspect Count],
    negative_qty_count                                   AS [Negative Qty Count],
    lot_missing_count                                    AS [Lot Missing Count],
    avg_trust_score                                      AS [Avg Trust Score],
    cycle_count_events                                   AS [Cycle Count Events],
    avg_cycle_count_variance                             AS [Avg Cycle Count Variance],
    IF(sku_positions > 0,
       1 - (phantom_suspect_count / sku_positions), 0)   AS [IRA %]
// SELECT location_id, sku_positions, total_on_hand, phantom_suspect_count,
//        negative_qty_count, lot_missing_count, avg_trust_score,
//        cycle_count_events, avg_cycle_count_variance
// FROM gold.supply_chain_health;
FROM [lib://MCG Demo - Development:MCG Open Lakehouse/gold_supply_chain_health.qvd]
(qvd);

// -----------------------------------------------------------------------------
// SUPPLY CHAIN HEALTH BY MONTH — gold.supply_chain_health_monthly
// -----------------------------------------------------------------------------
// The same facts at DC x month grain. The table above has no date, so any chart
// broken out by time reads the estate total in every bucket and draws a flat
// line; this one carries the month.
//
// Every measure column is aliased differently from the DC-grain table on
// purpose. Sharing six field names between two tables would make Qlik build a
// synthetic key, which silently wrecks both. [Distribution Center] is the one
// field they are meant to share.
// -----------------------------------------------------------------------------
SupplyChainHealthMonthly:
LOAD
    location_id                                          AS [Distribution Center],
    snapshot_month                                       AS [Snapshot Month],
    Date(Date#(snapshot_month_start, 'YYYY-MM-DD'))      AS [Snapshot Month Start],
    sku_positions                                        AS [Monthly SKU Positions],
    total_on_hand                                        AS [Monthly Total On Hand],
    phantom_suspect_count                                AS [Monthly Phantom Count],
    lot_missing_count                                    AS [Monthly Lot Missing Count],
    avg_trust_score                                      AS [Monthly Avg Trust Score],
    IF(sku_positions > 0,
       1 - (phantom_suspect_count / sku_positions), 0)   AS [Monthly IRA %]
// SELECT location_id, snapshot_month, snapshot_month_start, sku_positions,
//        total_on_hand, phantom_suspect_count, lot_missing_count, avg_trust_score
// FROM gold.supply_chain_health_monthly;
FROM [lib://MCG Demo - Development:MCG Open Lakehouse/gold_supply_chain_health_monthly.qvd]
(qvd);

// =============================================================================
// 2. INVENTORY DETAIL — silver.inventory_reconciled (position grain)
// =============================================================================

InventoryDetail:
LOAD
    location_id           AS [Distribution Center],
    sku                   AS [SKU],
    lot_number            AS [Lot Number],
    quantity_on_hand      AS [Qty On Hand],
    quantity_available    AS [Qty Available],
    quantity_reserved     AS [Qty Reserved],
    quantity_in_transit   AS [Qty In Transit],
    unit_of_measure       AS [Unit of Measure],
    storage_zone          AS [Storage Zone],
    logic_error           AS [Negative Qty Flag],
    phantom_suspect       AS [Phantom Suspect Flag],
    lot_missing           AS [Lot Missing Flag],
    last_count_date       AS [Last Count Date],
    snapshot_timestamp    AS [Snapshot Time],
    // Date-grain key for the master calendar. [Snapshot Time] is a timestamp
    // with ~45k distinct values, so a calendar keyed on it would join nothing;
    // this truncates to the day, which is what the calendar is built from.
    Date(Floor(snapshot_timestamp)) AS [Snapshot Date],
    trust_score           AS [Position Trust Score]
// SELECT location_id, sku, lot_number, quantity_on_hand, quantity_available,
//        quantity_reserved, quantity_in_transit, unit_of_measure, storage_zone,
//        logic_error, phantom_suspect, lot_missing, last_count_date,
//        snapshot_timestamp, trust_score
// FROM silver.inventory_reconciled;
FROM [lib://MCG Demo - Development:MCG Open Lakehouse/silver_inventory_reconciled.qvd]
(qvd);

// =============================================================================
// 3. PRODUCT MASTER — silver.products_harmonized
// =============================================================================

ProductMaster:
LOAD
    sku                              AS [SKU],
    legacy_sku_americas              AS [Legacy SKU (Americas)],
    legacy_sku_eu                    AS [Legacy SKU (EU)],
    product_name                     AS [Product Name],
    category_l1                      AS [Category],
    category_l2                      AS [Subcategory],
    category_l3                      AS [Category Detail],
    weight_kg                        AS [Weight (kg)],
    weight_imputed                   AS [Weight Imputed Flag],
    country_of_origin                AS [Country of Origin],
    origin_missing_compliance_risk   AS [Origin Compliance Risk],
    supplier_name_raw                AS [Supplier (Raw)],
    supplier_canonical               AS [Supplier]
// SELECT sku, legacy_sku_americas, legacy_sku_eu, product_name, category_l1,
//        category_l2, category_l3, weight_kg, weight_imputed, country_of_origin,
//        origin_missing_compliance_risk, supplier_name_raw, supplier_canonical
// FROM silver.products_harmonized;
FROM [lib://MCG Demo - Development:MCG Open Lakehouse/silver_products_harmonized.qvd]
(qvd);

// =============================================================================
// 4. COLD CHAIN TELEMETRY — silver.iot_normalized (streaming pipeline)
// =============================================================================

ColdChainTelemetry:
LOAD
    sensor_id             AS [Sensor ID],
    shipment_id           AS [IoT Shipment ID],
    timestamp             AS [Reading Time],
    temperature_value     AS [Temp (Raw)],
    temperature_unit      AS [Temp Unit],
    temperature_c         AS [Temperature (°C)],
    humidity_pct          AS [Humidity %],
    light_exposure        AS [Light Exposure],
    shock_detected        AS [Shock Detected],
    gps_latitude          AS [GPS Lat],
    gps_longitude         AS [GPS Lon],
    gps_gap               AS [GPS Gap Flag],
    battery_level_pct     AS [Battery %],
    battery_low           AS [Battery Low Flag],
    sensor_unregistered   AS [Sensor Unregistered Flag],
    alert_flag            AS [Temp Alert Flag],
    warehouse_id          AS [Distribution Center],
    route_id              AS [Route]
// SELECT sensor_id, shipment_id, timestamp, temperature_value, temperature_unit,
//        temperature_c, humidity_pct, light_exposure, shock_detected,
//        gps_latitude, gps_longitude, gps_gap, battery_level_pct, battery_low,
//        sensor_unregistered, alert_flag, warehouse_id, route_id
// FROM silver.iot_normalized;
FROM [lib://MCG Demo - Development:MCG Open Lakehouse/silver_iot_normalized.qvd]
(qvd);

// =============================================================================
// 5. LIVE CARRIER EVENTS — bronze.iot_carrier_events (raw stream)
// =============================================================================

CarrierEventsLive:
LOAD *
// SELECT * FROM bronze.iot_carrier_events;
FROM [lib://MCG Demo - Development:MCG Open Lakehouse/bronze_iot_carrier_events.qvd]
(qvd);

// =============================================================================
// CALENDAR (Master Calendar for time intelligence)
// =============================================================================

MinMaxDates:
LOAD
    MIN(Date(Floor([Snapshot Time]))) AS MinDate,
    MAX(Date(Floor([Snapshot Time]))) AS MaxDate
RESIDENT InventoryDetail;

LET vMinDate = Peek('MinDate', 0, 'MinMaxDates');
LET vMaxDate = Peek('MaxDate', 0, 'MinMaxDates');
DROP TABLE MinMaxDates;

// Keyed on [Snapshot Date], NOT a bare [Date]. Aliasing it [Date] left the
// calendar as an orphan island sharing no field with any table: every chart
// broken out by month silently returned the grand total for every month,
// with no error anywhere. app2's calendar keys to [Order Date] for the
// same reason.
Calendar:
LOAD
    Date                       AS [Snapshot Date],
    Year(Date)                 AS [Year],
    Month(Date)                AS [Month],
    MonthName(Date)            AS [Month Name],
    Day(Date)                  AS [Day],
    WeekDay(Date)              AS [Weekday],
    Week(Date)                 AS [Week Number],
    'Q' & Ceil(Month(Date)/3)  AS [Quarter]
;
LOAD
    Date('$(vMinDate)' + IterNo() - 1) AS Date
AUTOGENERATE 1
WHILE Date('$(vMinDate)' + IterNo() - 1) <= '$(vMaxDate)';

// =============================================================================
// NIGHTMARE REFERENCE (Static mapping)
// =============================================================================

NightmareRef:
LOAD * INLINE [
    NightmareID, NightmareName, AnnualCost, Description
    1, Phantom Inventory, 48000000, ERP vs WMS mismatch causing stockouts
    2, Address Catastrophe, 3100000, 11% format issues causing 4.7% carrier rejection
    3, Product Master Mess, 8200000, 8200 missing weights and duplicate suppliers
    4, Silent Pipeline Failures, 12000000, Rotterdam CDC: 72h undetected outage
    5, Timestamp Tower of Babel, 6500000, Mixed UTC/local/bare timestamps across sources
    6, Carrier Data Black Hole, 14800000, 6 carriers 5 languages no canonical mapping
    7, Compliance Traceability Gap, 4200000, Lettuce recall: 11 days vs 24h requirement
];
