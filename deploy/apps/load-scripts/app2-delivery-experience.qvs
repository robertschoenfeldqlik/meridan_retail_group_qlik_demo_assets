// =============================================================================
// MCG Delivery & Customer Experience — Qlik Analytics Load Script
// =============================================================================
// Loads directly from the data products and silver datasets created by the
// MCG Batch + Streaming Pipelines (declarative QTCP projects).
//
// Data Product (Gold):
//   - gold.last_mile_performance      (per carrier/country KPIs — Data Product "Last Mile Performance")
//
// Silver datasets (detail):
//   - silver.order_delivery_timeline  (order lifecycle behind the gold KPIs)
//   - silver.shipments_canonical      (canonical carrier shipment statuses)
//   - silver.addresses_standardized   (customer addresses + quality scores)
//
// Bronze (live feed):
//   - bronze.iot_carrier_events
//
// The connection name matches the deploy config (dataConnections / bindings).
// =============================================================================

SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='YYYY-MM-DD';
SET TimestampFormat='YYYY-MM-DD hh:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;

LIB CONNECT TO 'MCG Open Lakehouse';

// =============================================================================
// 1. LAST MILE PERFORMANCE — Data Product (gold, carrier/country grain)
// =============================================================================

LastMilePerformance:
LOAD
    carrier_code             AS [Carrier],
    destination_country      AS [Country],
    orders                   AS [Orders],
    delivered_orders         AS [Delivered Orders],
    late_deliveries          AS [Late Deliveries],
    on_time_rate             AS [On-Time Rate],
    avg_days_late            AS [Avg Days Late],
    wismo_inquiries          AS [WISMO Inquiries],
    wismo_rate               AS [WISMO Rate],
    tracking_missing_count   AS [Tracking Missing Count],
    avg_address_quality      AS [Avg Address Quality];
SELECT carrier_code, destination_country, orders, delivered_orders,
       late_deliveries, on_time_rate, avg_days_late, wismo_inquiries,
       wismo_rate, tracking_missing_count, avg_address_quality
FROM gold.last_mile_performance;

// =============================================================================
// 2. ORDER TIMELINE — silver.order_delivery_timeline (order grain)
// =============================================================================

OrderTimeline:
LOAD
    order_id              AS [Order ID],
    contact_id            AS [Contact ID],
    order_date            AS [Order Date],
    sku                   AS [SKU],
    product_name          AS [Product Name],
    fulfillment_method    AS [Fulfillment Method],
    carrier_code          AS [Carrier],
    tracking_number       AS [Tracking Number],
    order_status          AS [Order Status],
    promised_delivery     AS [Promised Delivery],
    actual_delivery       AS [Actual Delivery],
    tracking_missing      AS [Tracking Missing Flag],
    delivered_late        AS [Delivered Late Flag],
    days_late             AS [Days Late],
    wismo_flag            AS [WISMO Flag],
    shipment_id           AS [Shipment ID],
    carrier_status_raw    AS [Carrier Status],
    delivery_attempts     AS [Delivery Attempts],
    exception_code        AS [Exception Code];
SELECT order_id, contact_id, order_date, sku, product_name,
       fulfillment_method, carrier_code, tracking_number, order_status,
       promised_delivery, actual_delivery, tracking_missing, delivered_late,
       days_late, wismo_flag, shipment_id, carrier_status_raw,
       delivery_attempts, exception_code
FROM silver.order_delivery_timeline;

// =============================================================================
// 3. SHIPMENTS CANONICAL — silver.shipments_canonical
// =============================================================================
// Linked to OrderTimeline via [Shipment ID]; other fields aliased to avoid
// synthetic keys.
// =============================================================================

ShipmentsCanonical:
LOAD
    shipment_id                   AS [Shipment ID],
    tracking_number               AS [Ship Tracking Number],
    carrier_code                  AS [Ship Carrier],
    order_id                      AS [Ship Order ID],
    shipment_status_raw           AS [Status (Raw)],
    shipment_status               AS [Status (Canonical)],
    status_datetime_raw           AS [Status Time (Raw)],
    origin_facility               AS [Origin DC],
    destination_city              AS [Ship-To City],
    destination_country           AS [Ship-To Country],
    estimated_delivery            AS [Estimated Delivery],
    actual_delivery               AS [Ship Actual Delivery],
    delivery_attempts             AS [Ship Delivery Attempts],
    exception_code                AS [Ship Exception Code],
    weight_kg                     AS [Weight (kg)],
    delivered_without_timestamp   AS [Delivered w/o Timestamp Flag];
SELECT shipment_id, tracking_number, carrier_code, order_id,
       shipment_status_raw, shipment_status, status_datetime_raw,
       origin_facility, destination_city, destination_country,
       estimated_delivery, actual_delivery, delivery_attempts,
       exception_code, weight_kg, delivered_without_timestamp
FROM silver.shipments_canonical;

// =============================================================================
// 4. CUSTOMER ADDRESSES — silver.addresses_standardized
// =============================================================================
// Linked to OrderTimeline via [Contact ID].
// =============================================================================

CustomerAddresses:
LOAD
    contact_id              AS [Contact ID],
    first_name              AS [First Name],
    last_name               AS [Last Name],
    email                   AS [Email],
    city                    AS [Customer City],
    state_region            AS [Customer Region],
    postal_code             AS [Postal Code],
    country_iso             AS [Customer Country],
    address_quality_score   AS [Address Quality Score];
SELECT contact_id, first_name, last_name, email, city, state_region,
       postal_code, country_iso, address_quality_score
FROM silver.addresses_standardized;

// =============================================================================
// 5. LIVE CARRIER EVENTS — bronze.iot_carrier_events (raw stream)
// =============================================================================

CarrierEventsLive:
LOAD *;
SELECT * FROM bronze.iot_carrier_events;

// =============================================================================
// CALENDAR (Master Calendar for time intelligence)
// =============================================================================

MinMaxDates:
LOAD
    MIN(Date(Floor([Order Date]))) AS MinDate,
    MAX(Date(Floor([Order Date]))) AS MaxDate
RESIDENT OrderTimeline;

LET vMinDate = Peek('MinDate', 0, 'MinMaxDates');
LET vMaxDate = Peek('MaxDate', 0, 'MinMaxDates');
DROP TABLE MinMaxDates;

Calendar:
LOAD
    Date                       AS [Order Date],
    Year(Date)                 AS [Year],
    Month(Date)                AS [Month],
    MonthName(Date)            AS [Month Name],
    Day(Date)                  AS [Day],
    WeekDay(Date)              AS [Weekday],
    Week(Date)                 AS [Week Number],
    'Q' & Ceil(Month(Date)/3)  AS [Quarter]
;
LOAD
    Date('$(vMinDate)' + IterNo() - 1) AS Date
AUTOGENERATE 1
WHILE Date('$(vMinDate)' + IterNo() - 1) <= '$(vMaxDate)';
