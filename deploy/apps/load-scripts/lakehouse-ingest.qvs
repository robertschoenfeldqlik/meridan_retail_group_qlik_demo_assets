LakehouseTables:
LOAD * INLINE [
  table, landed
  bronze_iot_carrier_events, 1
  gold_last_mile_performance, 1
  gold_supply_chain_health, 1
  gold_supply_chain_health_monthly, 1
  MCG_CRM_Addresses_Validated, 1
  silver_addresses_standardized, 1
  silver_inventory_reconciled, 1
  silver_iot_normalized, 1
  silver_order_delivery_timeline, 1
  silver_products_harmonized, 1
  silver_shipments_canonical, 1
];
