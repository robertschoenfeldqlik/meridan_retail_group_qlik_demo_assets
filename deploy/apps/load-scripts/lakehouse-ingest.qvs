// ---------------------------------------------------------------------------
//  MCG Open Lakehouse Ingest
//  Lands the bronze, silver and gold tables into the MCG Open Lakehouse connection
//  and stores each one in columnar form for the analytics apps to consume.
//  One LOAD + STORE per table; table names, columns and grain match the catalog.
// ---------------------------------------------------------------------------

[bronze_iot_carrier_events]:
LOAD *
FROM [lib://MCG Demo - Development:MCG Open Lakehouse/bronze_iot_carrier_events.csv]
(txt, utf8, embedded labels, delimiter is ',', msq);
STORE [bronze_iot_carrier_events] INTO [lib://MCG Demo - Development:MCG Open Lakehouse/bronze_iot_carrier_events.qvd] (qvd);
DROP TABLE [bronze_iot_carrier_events];
TRACE Landed bronze_iot_carrier_events;

