# =============================================================================
# MCG Kafka Configuration
# =============================================================================
# Default environment variables for docker-compose.yml.
# Override any value here or pass via shell: KAFKA_BROKER_PORT=19092 npm run docker:up:kafka
# =============================================================================

# Confluent Platform image version (cp-zookeeper, cp-kafka, cp-schema-registry, etc.)
CONFLUENT_VERSION=7.7.1

# Kafka broker PLAINTEXT listener — used by local simulators
KAFKA_BROKER_PORT=9092

# Kafka external PLAINTEXT listener — used by Data Movement Gateway
KAFKA_EXTERNAL_PORT=29092

# Confluent Control Center web UI
CONTROL_CENTER_PORT=9021

# Schema Registry REST API
SCHEMA_REGISTRY_PORT=8081
