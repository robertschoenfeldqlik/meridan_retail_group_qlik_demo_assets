# =============================================================================
# MCG Demo — Environment Variables
# =============================================================================

# --- Confluent Kafka Stack ---
CONFLUENT_VERSION=7.7.1
KAFKA_BROKER_PORT=9092
KAFKA_EXTERNAL_PORT=29092
SCHEMA_REGISTRY_PORT=8081
CONTROL_CENTER_PORT=9021

# --- PostgreSQL (WMS Database) ---
POSTGRES_DB=mcg_wms
POSTGRES_USER=mcg_admin
POSTGRES_PASSWORD=mcg_demo_2025
POSTGRES_PORT=5432

# --- Kafka Bootstrap (for simulator connecting to broker) ---
KAFKA_BOOTSTRAP=kafka:9092

# --- Salesforce (only needed if running SF simulator) ---
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# --- Qlik Data Movement Gateway (only for DMG deployment option) ---
# Used by: docker-compose.full-stack-dmg.yml
# Download the Gateway RPM from:
#   https://github.com/qlik-download/saas-download-links/releases
# Place as: infrastructure/dmg/gateway/rpmfiles/gateway.rpm
TENANT_URL=your-tenant.us.qlikcloud.com
DMG_POSTGRES_PASSWORD=Qlik1234
DMG_MYSQL_PASSWORD=Qlik1234
DMG_MSSQL_PASSWORD=Qlik1234!
DMG_PG_USER=postgres
DMG_PG_PORT=5432
DMG_MYSQL_PORT=3306
DMG_MSSQL_PORT=1433
DMG_SSH_PORT=2222
